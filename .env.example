# Postgres connection string (local: see docker-compose.yml; prod: Neon/Supabase)
DATABASE_URL=
# Optional: connection used only by migrations on production deploys, when DATABASE_URL is a
# transaction pooler (e.g. Supabase port 6543). Use the session pooler or direct connection here.
DATABASE_MIGRATION_URL=
# Public base URL of the app, no trailing slash. Used to build password setup links.
APP_URL=
# "true" only for the sandbox demo: the seed gives every member DEMO_PASSWORD and /login shows demo accounts.
DEMO_MODE=
# Shared password for seeded demo members (min 10 characters). Ignored unless DEMO_MODE=true.
DEMO_PASSWORD=
# Meetings: Google Calendar "Secret address in iCal format" (.ics URL). Set it and meetings are pulled automatically every 15 minutes.
# Without it, admins upload an .ics export on /admin/meetings.
MEETINGS_ICS_URL=
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders (every 5 minutes).
CRON_SECRET=
# Email for meeting reminders (any SMTP server). Without SMTP_HOST, emails are only recorded, not sent.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (TLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Shapers Hub <hub@example.org>"
MAIL_FROM=
# Optional: send every email to this one address instead (demo, testing)
MAIL_REDIRECT_TO=
# Unused (meetings come from the iCal export); kept for an API-based calendar sync
GOOGLE_CALENDAR_ID=
GOOGLE_API_KEY=
# Google Sheets task import (read-only). Share the sheet with the service account email as Viewer.
GOOGLE_SHEET_ID=
# Tab to import tasks from (default List1)
GOOGLE_SHEET_TASKS_TAB=
# Tab that work hours are written to (default "Ure dela"). Needs the service account as Editor.
GOOGLE_SHEET_HOURS_TAB=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, on one line with \n for newlines, in double quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional (AI)
# Turns on "Create tasks from notes" on meeting pages (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
# Optional: the model for it (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional (Slack extras)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
