# Postgres connection string (local: see docker-compose.yml; prod: Neon/Supabase)
DATABASE_URL=
# Optional: connection used only by migrations on production deploys, when DATABASE_URL is a
# transaction pooler (e.g. Supabase port 6543). Use the session pooler or direct connection here.
DATABASE_MIGRATION_URL=
# Optional: database for npm test. Default: DATABASE_URL's local server with "_test" added to the name.
TEST_DATABASE_URL=
# Public base URL of the app, no trailing slash. Used to build password setup links.
APP_URL=
# "true" only for the sandbox demo: the seed gives every member DEMO_PASSWORD and /login shows demo accounts.
DEMO_MODE=
# Shared password for seeded demo members (min 10 characters). Ignored unless DEMO_MODE=true.
DEMO_PASSWORD=
# Meetings: Google Calendar "Secret address in iCal format" (.ics URL). Set it and meetings are pulled automatically every 15 minutes.
# Without it, admins upload an .ics export on /admin/meetings.
MEETINGS_ICS_URL=
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders (every 5 minutes).
CRON_SECRET=
# Email for meeting reminders (any SMTP server). Without SMTP_HOST, emails are only recorded, not sent.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (TLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: time limit in milliseconds for each SMTP step (default 10000)
SMTP_TIMEOUT_MS=
# Sender, e.g. "Shapers Hub <hub@example.org>"
MAIL_FROM=
# Optional: send every email to this one address instead (demo, testing)
MAIL_REDIRECT_TO=
# Unused (meetings come from the iCal export); kept for an API-based calendar sync
GOOGLE_CALENDAR_ID=
GOOGLE_API_KEY=
# Google Sheet for tasks (two-way) and hours, shared with the service account as Editor.
# Locally, use a copy of the sheet, never the one production uses.
GOOGLE_SHEET_ID=
# Tab to import tasks from (default List1)
GOOGLE_SHEET_TASKS_TAB=
# Tab that work hours are written to (default "Ure dela"). Needs the service account as Editor.
GOOGLE_SHEET_HOURS_TAB=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, on one line with \n for newlines, in double quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Meeting recordings: any S3-compatible bucket (e.g. Cloudflare R2). Browsers upload and play straight from it,
# so its CORS must allow PUT and GET from APP_URL. Without these, local development stores recordings in .data/
# and production can record (download only) but not store or upload.
# Endpoint, e.g. https://<account id>.r2.cloudflarestorage.com (leave empty for AWS S3)
RECORDINGS_S3_ENDPOINT=
# Region (default auto, which R2 uses)
RECORDINGS_S3_REGION=
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=
# Optional (AI)
# Turns on "Create tasks from notes" and "Ask about a meeting" (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
# Optional: the model for it (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional (meeting recorder). Supabase Storage with a private bucket "meeting-recordings".
# Server-side only: the service role key is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional (transcribing recordings): any OpenAI-compatible speech-to-text service, default Groq.
# Without a key the Transcribe button is hidden.
TRANSCRIBE_API_KEY=
# Default https://api.groq.com/openai/v1
TRANSCRIBE_BASE_URL=
# Default whisper-large-v3
TRANSCRIBE_MODEL=
# Fallback: if TRANSCRIBE_API_KEY is empty, this key is used with OpenAI's address and whisper-1
OPENAI_API_KEY=
# Optional (Slack extras). Bot User OAuth Token (xoxb-...) with scopes chat:write, channels:read,
# channels:join, users:read, users:read.email. Turns on meeting announcements in Slack (Admin -> Slack).
# Set it in ONE environment per workspace: a local copy and production would each announce every meeting.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
